# 🚕 AKASYA DURAĞ TELSIZI - ENVIRONMENT VARIABLES
# Bu değerleri Render Dashboard -> Environment -> Add Variable bölümüne yapıştır

# ==========================================
# ⭐ ZORUNLU - Discord Bot Token
# ==========================================
# Nereden bulacaksın: https://discord.com/developers/applications
# 1. "New Application" tıkla (varsa zaten olanı seç)
# 2. Sol menüden "Bot" seçin
# 3. "Reset Token" tıkla, kopyalayıp buraya yapıştır
TOKEN=your_discord_bot_token_here

# Web sunucusu portu (Render otomatik ayarlar, değiştirme)
PORT=3000

# ==========================================
# 🎮 ÜCRETSİZ OYUN TAKİBİ - ZORUNLU
# ==========================================
# Nereden bulacaksın: Discord -> Ayarlar -> Gelişmiş -> "Developer Mode" aç
# -> Ücretsiz oyun bildirimleri göndermek istediğin kanala SAĞ TIK -> "Copy Channel ID"
FREE_GAMES_CHANNEL_ID=123456789012345678

# Kontrol aralığı (ms) - 30 dakika = 1800000 ms
# İstemiyorsan bu satırı silip default (30 dakika) kullan
FREE_GAMES_CHECK_INTERVAL_MS=1800000

# ==========================================
# 🧱 MINECRAFT / ATERNOS - İsteğe bağlı
# ==========================================
# Minecraft sunucu adresi
# Nereden: https://aternos.org/server/ -> Sunucunun sayfasında URL'ye bak
# Örnek URL: https://aternos.org/server/akasya_duragi/
# -> MC_SERVER_HOST=akasya_duragi.aternos.me yaz
MC_SERVER_HOST=your_server.aternos.me

# Sunucu portu (Aternos genelde 25565)
MC_SERVER_PORT=25565

# MC durumu bildirim gidecek kanal
# FREE_GAMES_CHANNEL_ID'den farklı istersen değiştir, yoksa silebilirsin
MC_SERVER_CHANNEL_ID=123456789012345678

# Kontrol aralığı (ms) - 60 saniye = 60000 ms
MC_SERVER_CHECK_INTERVAL_MS=60000

# ==========================================
# ⚡ ATERNOS API - SUNUCU START/STOP - İsteğe bağlı
# ⚠️ BU OLMADAN: !aternos start / !aternos stop çalışmaz (sadece status çalışır)
# ==========================================

# Aternos Server ID - API kullanacaksan ZORUNLU
# Nereden: https://aternos.org/server/ git
# URL'ne bak: https://aternos.org/server/abc123def456/
# "abc123def456" kısmını kopyala
ATERNOS_SERVER_ID=your_aternos_server_id

# Aternos API URL (varsayılan olarak https://aternos.org olarak ayarlanmış, değiştirme)
ATERNOS_API_BASE_URL=https://aternos.org

# ==========================================
# 🔐 ATERNOS COOKIE - NASIL ALACAKSIN? (ADIM ADIM)
# ==========================================
# ADIM 1: Tarayıcıda https://aternos.org'a GİRİŞ YAP
# 
# ADIM 2: Sayfayı açtıktan sonra F12 tuşuna bas (Developer Tools açılır)
# 
# ADIM 3: Üst kısımda 5 sekmeden biri "Network" sekmesine tıkla
# 
# ADIM 4: Sayfayı yenile (F5 tuşu)
# 
# ADIM 5: Listeye bak, gördüğün istek listesinden birine tıkla
#         (örn: "profile", "status", veya sayfanın URL'sinin adı)
# 
# ADIM 6: Sağ tarafta açılan panelde "Headers" sekmesi aç
# 
# ADIM 7: "Request Headers" bölümünü bul, "Cookie:" ile başlayan satırı ara
#         Burada "ATERNOS_SESSION=..." şeklinde bir şey olacak
# 
# ADIM 8: ATERNOS_SESSION= den başlayan TÜM COOKİE DEĞERİNİ KOPYALAtiyıp aşağıya yapıştır
#         Örn: ATERNOS_SESSION=abcd1234efgh5678; SECURE_SESSION=xyz789abc

# Cookie değeri (START/STOP komutları için)
ATERNOS_SESSION_COOKIE=your_aternos_session_cookie_here

# ==========================================
# 📝 NOTLAR & TÜYOLAR
# ==========================================
# ✅ Render'a Deploy Etmek:
# 1. GitHub'a push yap
# 2. Render Dashboard'a gir (https://dashboard.render.com)
# 3. "New +" -> "Web Service" seçin
# 4. GitHub repo'unu bağla
# 5. "Environment" sekmesine git
# 6. Yukarıdaki her bir değeri "Add Environment Variable" ile ekle
# 7. "Deploy" butonuna tıkla
#
# ✅ Yerel Geliştirme:
# - Bu dosyayı kopyala: cp .env.example .env
# - .env dosyasını doldur
# - npm start ile başlat
#
# ⚠️ Güvenlik:
# - Render ve GitHub'a Token/Cookie gibi hassas veri AÇIK METIN olarak GİRME
# - Render "Secret" olarak işaretle (Private olarak saklar)
# - .env dosyası .gitignore'da (GitHub'a yüklenmez)
